#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - CHECK LOGIN TROJAN-WS
#   Minimalist 54-Column Modern Clean Table
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}            MONITORING LOGIN USER TROJAN            ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME          LOGIN IP   LIMIT IP  STAT   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

data=( $(grep -E "^#! " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort -u) )

count=0
online=0

for akun in "${data[@]}"; do
    [[ -z "$akun" ]] && continue
    ((count++))
    num_str=$(printf "%02d" "$count")
    
    # Deteksi live IP dari access.log Xray 500 baris terakhir
    active_ips=$(grep -w "$akun" /var/log/xray/access.log 2>/dev/null | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort -u | grep -vE "^$|^127\.0\.0\.1$")
    ip_count=$(echo "$active_ips" | grep -v "^$" | wc -l)
    
    iplimit=$(cat "/etc/kyt/limit/trojan/ip/${akun}" 2>/dev/null || echo "0")
    if [[ "$iplimit" == "0" || -z "$iplimit" ]]; then
        iplimit="No Limit"
    else
        iplimit="${iplimit} IP"
    fi
    
    if [ "$ip_count" -gt 0 ]; then
        ((online++))
        status_tag="${C_VAL}ON    ${NC}"
        login_str="${ip_count} IP"
    else
        status_tag="${C_OFF}OFF   ${NC}"
        login_str="0 IP"
    fi
    
    printf "${C_BORDER}│${NC}  ${C_NUM}%-3s${NC} ${C_TEXT}%-17s${NC} ${C_VAL}%-10s${NC} ${C_CYAN}%-10s${NC}${status_tag}${C_BORDER}│${NC}\n" \
        "$num_str" "${akun:0:17}" "$login_str" "$iplimit"
done

if [ "$count" -eq 0 ]; then
    printf "${C_BORDER}│${C_OFF}           TIDAK ADA AKUN TROJAN TERDAFTAR          ${C_BORDER}│${NC}\n"
fi

echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT}  Total: ${C_NUM}%-2s${C_TEXT} User        Online: ${C_VAL}%-2s${C_TEXT}       Offline: ${C_OFF}%-2s${C_BORDER}│${NC}\n" \
    "$count" "$online" "$((count - online))"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""
read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali ke menu..."
