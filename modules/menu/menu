export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Check License Validity Real-Time
check_license() {
    local client_name
    local client_exp
    local exp_ts
    client_name=$(cat /etc/kyt/client_name 2>/dev/null || echo "Unknown")
    client_exp=$(cat /etc/kyt/client_exp 2>/dev/null || echo "Expired")
    exp_ts=$(cat /etc/kyt/client_exp_ts 2>/dev/null)

    if [[ -z "$exp_ts" ]]; then
        local raw_date
        raw_date=$(echo "$client_exp" | sed 's/\[//; s/\]//')
        exp_ts=$(date -d "$raw_date" +%s 2>/dev/null || echo "0")
    fi

    local now_ts
    now_ts=$(date +%s)

    if [[ "$client_exp" != *"Lifetime"* ]] && [[ "$exp_ts" -gt 0 ]] && [[ "$now_ts" -gt "$exp_ts" ]]; then
        /usr/local/sbin/license-watchdog 2>/dev/null || true
        clear
        echo ""
        echo -e "\033[38;5;196m┌────────────────────────────────────────────────────┐\033[0m"
        echo -e "\033[38;5;196m│\033[1;37m                LISENSI TELAH EXPIRED               \033[38;5;196m│\033[0m"
        echo -e "\033[38;5;196m├────────────────────────────────────────────────────┤\033[0m"
        echo -e "\033[38;5;196m│\033[0m  Masa aktif autoscript VPS Anda telah berakhir!    \033[38;5;196m│\033[0m"
        printf "\033[38;5;196m│\033[0m  Client    : \033[1;33m%-38s\033[38;5;196m│\033[0m\n" "$client_name"
        printf "\033[38;5;196m│\033[0m  Expired On: \033[1;31m%-38s\033[38;5;196m│\033[0m\n" "${client_exp} (EXPIRED)"
        echo -e "\033[38;5;196m├────────────────────────────────────────────────────┤\033[0m"
        echo -e "\033[38;5;196m│\033[0m  Silakan hubungi admin untuk perpanjang lisensi:   \033[38;5;196m│\033[0m"
        printf "\033[38;5;196m│\033[0m  Telegram  : \033[1;36m%-38s\033[38;5;196m│\033[0m\n" "@Bayuu_XD"
        printf "\033[38;5;196m│\033[0m  Channel   : \033[1;36m%-38s\033[38;5;196m│\033[0m\n" "@aibansos"
        echo -e "\033[38;5;196m└────────────────────────────────────────────────────┘\033[0m"
        echo ""
        exit 1
    fi
}
check_license

# High-Contrast VIP Palette
C_BORDER="\033[38;5;39m"     # Deep Sky Blue
C_TITLE="\033[1;38;5;51m"    # Bright Cyan Bold
C_SUB="\033[38;5;246m"       # Silver Gray
C_HEAD="\033[1;38;5;220m"    # Warm Yellow Bold
C_TEXT="\033[38;5;253m"      # Crisp Off-White
C_VAL="\033[1;38;5;255m"     # Pure White Bold
C_NUM="\033[1;38;5;51m"      # Neon Cyan
C_ON="\033[1;38;5;84m"       # Vibrant Green
C_OFF="\033[1;38;5;196m"     # Pure Red
C_RED="\033[1;38;5;203m"     # Soft Red
C_GOLD="\033[1;38;5;214m"    # Gold
NC="\033[0m"

# Fast IPC Service Checks
chk_ssh() {
    if systemctl is-active --quiet ws 2>/dev/null || systemctl is-active --quiet dropbear 2>/dev/null; then
        echo -e "${C_ON}ON ${NC}"
    else
        echo -e "${C_OFF}OFF${NC}"
    fi
}
chk_xray() {
    if systemctl is-active --quiet xray 2>/dev/null || systemctl is-active --quiet runn 2>/dev/null; then
        echo -e "${C_ON}ON ${NC}"
    else
        echo -e "${C_OFF}OFF${NC}"
    fi
}

S_SSH=$(chk_ssh)
S_VMESS=$(chk_xray)
S_VLESS=$(chk_xray)
S_TROJAN=$(chk_xray)

# Hitung Total Akun Tiap Protokol Real-Time (FIX: Single Integer Output)
TOTAL_SSH=$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd 2>/dev/null | wc -l)
TOTAL_VMESS=$(grep -c -E "^### " "/etc/xray/config.json" 2>/dev/null) || TOTAL_VMESS=0
TOTAL_VLESS=$(grep -c -E "^#& " "/etc/xray/config.json" 2>/dev/null) || TOTAL_VLESS=0
TOTAL_TROJAN=$(grep -c -E "^#! " "/etc/xray/config.json" 2>/dev/null) || TOTAL_TROJAN=0

# System Hardware & Identity
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || cat /root/domain 2>/dev/null || echo "vpn.bayuuvx.com")
IP=$(cat /etc/xray/ipvps 2>/dev/null)
if [[ "$IP" =~ : ]] || [[ -z "$IP" ]]; then
    IP=$(curl -s -4 ipv4.icanhazip.com 2>/dev/null || curl -s -4 ifconfig.me 2>/dev/null || wget -qO- -4 icanhazip.com 2>/dev/null || echo "178.128.214.12")
    echo "$IP" > /etc/xray/ipvps 2>/dev/null || true
fi
OS_RAW=$(cat /etc/os-release 2>/dev/null | grep -w PRETTY_NAME | cut -d= -f2 | tr -d '"' || echo "Ubuntu 24.04")
RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
RAM_STR="${RAM_USED}/${RAM_TOTAL}M"
UPTIME=$(uptime -p 2>/dev/null | sed 's/up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/' | cut -d, -f1-2 || echo "1h")
KERNEL=$(uname -r | cut -d- -f1-2)
ISP=$(cat /etc/xray/isp 2>/dev/null)
[[ -z "$ISP" ]] && ISP="DigitalOcean, LLC"

# License / Client Identity Info
CLIENT_NAME=$(cat /etc/kyt/client_name 2>/dev/null)
[[ -z "$CLIENT_NAME" ]] && CLIENT_NAME="Bayu XD"
EXP_DAYS=$(cat /etc/kyt/client_exp 2>/dev/null)
[[ -z "$EXP_DAYS" ]] && EXP_DAYS="Lifetime (VIP)"
STATUS_LIC="Active (HWID)"

clear 2>/dev/null || true

echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_TITLE}              BAYU XD TUNNELING SYSTEM              ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│${C_SUB}           Premium Multi-Protocol Gateway           ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}                 SYSTEM INFORMATION                 ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "OS Linux" "${OS_RAW:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "Kernel Core" "${KERNEL:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "RAM Memory" "${RAM_STR:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "Uptime Server" "${UPTIME:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "IP VPS (IPv4)" "${IP:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_VAL}%-32s ${C_BORDER}│${NC}\n" "ISP Provider" "${ISP:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_TITLE}%-32s ${C_BORDER}│${NC}\n" "Domain Host" "${DOMAIN:0:32}"
echo -e "${C_BORDER}├─────────────────────────┬──────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}     SERVICE STATUS      ${C_BORDER}│${C_HEAD}      TOTAL AKUN VPN      ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├─────────────────────────┼──────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT} SSH-WS    : [${S_SSH}${C_TEXT}]       ${C_BORDER}│${C_TEXT} SSH Account    : ${C_VAL}%-2s User${C_BORDER} │${NC}\n" "$TOTAL_SSH"
printf "${C_BORDER}│${C_TEXT} VMess-WS  : [${S_VMESS}${C_TEXT}]       ${C_BORDER}│${C_TEXT} VMess Account  : ${C_VAL}%-2s User${C_BORDER} │${NC}\n" "$TOTAL_VMESS"
printf "${C_BORDER}│${C_TEXT} VLESS-WS  : [${S_VLESS}${C_TEXT}]       ${C_BORDER}│${C_TEXT} VLESS Account  : ${C_VAL}%-2s User${C_BORDER} │${NC}\n" "$TOTAL_VLESS"
printf "${C_BORDER}│${C_TEXT} Trojan-WS : [${S_TROJAN}${C_TEXT}]       ${C_BORDER}│${C_TEXT} Trojan Account : ${C_VAL}%-2s User${C_BORDER} │${NC}\n" "$TOTAL_TROJAN"
echo -e "${C_BORDER}├─────────────────────────┴──────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}                  MANAGEMENT MENU                   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├─────────────────────────┬──────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_NUM}01${C_TEXT}] SSH & WS Menu      ${C_BORDER}│${C_TEXT} [${C_NUM}06${C_TEXT}] Check Port          ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_NUM}02${C_TEXT}] VMess Manager      ${C_BORDER}│${C_TEXT} [${C_NUM}07${C_TEXT}] Reboot Server       ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_NUM}03${C_TEXT}] VLESS Manager      ${C_BORDER}│${C_TEXT} [${C_NUM}08${C_TEXT}] Restart Service     ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_NUM}04${C_TEXT}] Trojan Manager     ${C_BORDER}│${C_TEXT} [${C_HEAD}09${C_TEXT}] Renew SSL Cert      ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_NUM}05${C_TEXT}] Speedtest VPS      ${C_BORDER}│${C_TEXT} [${C_CYAN}10${C_TEXT}] Update Autoscript   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├─────────────────────────┴──────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_RED}00${C_TEXT}] Exit to Shell                                 ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}            CLIENT & LICENSE INFORMATION            ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_GOLD}%-32s ${C_BORDER}│${NC}\n" "Client Name" "${CLIENT_NAME:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_ON}%-32s ${C_BORDER}│${NC}\n" "License Status" "${STATUS_LIC:0:32}"
printf "${C_BORDER}│${C_TEXT} %-16s: ${C_ON}%-32s ${C_BORDER}│${NC}\n" "Expired On" "${EXP_DAYS:0:32}"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""
echo -ne "${C_TITLE}» Select Option ${C_VAL}[00-10]${C_TITLE}: ${NC}"
read -r opt

case "$opt" in
    1|01) m-sshws 2>/dev/null || menu ;;
    2|02) m-vmess 2>/dev/null || menu ;;
    3|03) m-vless 2>/dev/null || menu ;;
    4|04) m-trojan 2>/dev/null || menu ;;
    5|05) speedtest 2>/dev/null || menu ;;
    6|06) netstat -tulpn | grep LISTEN || ss -tulpn ; read -rp "Tekan Enter..." ; menu ;;
    7|07) reboot ;;
    8|08) 
        systemctl restart ws dropbear nginx haproxy xray 2>/dev/null
        echo -e "\n${C_ON}Service berhasil di-restart!${NC}"
        sleep 1
        menu
        ;;
    9|09)
        /root/.acme.sh/acme.sh --renew -d "$DOMAIN" --force 2>/dev/null || true
        cat /etc/xray/xray.crt /etc/xray/xray.key > /etc/haproxy/hap.pem 2>/dev/null || true
        systemctl restart haproxy 2>/dev/null || true
        echo -e "\n${C_ON}SSL berhasil diperbarui!${NC}"
        sleep 1
        menu
        ;;
    10)
        update
        ;;
    0|00|x|q)
        echo -e "\n${C_ON}Keluar ke terminal shell root.${NC}\n"
        exit 0
        ;;
    *)
        menu
        ;;
esac
