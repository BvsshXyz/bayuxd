function cek_ssh() {
    touch /root/.system
    echo -e "  ───────────────────────────────────────"
    echo -e "            ️ USER LOGIN SSH  ️"
    echo -e "  ───────────────────────────────────────"
    echo -e "     LOGIN IP    LIMIT IP    USERNAME "
    mulog=$(cekssh)
    data=( $(cat /etc/passwd | grep home | cut -d ' ' -f 1 | cut -d : -f 1) );

    for user in "${data[@]}"; do
        cekcek=$(echo -e "$mulog" | grep $user | wc -l)
        if [[ $cekcek -gt 0 ]]; then
            iplimit=$(cat /etc/kyt/limit/ssh/ip/$user)
            printf "  %-13s %-7s %-8s %2s\n" "     ${cekcek} IP        ${iplimit} IP      ${user}"
            echo "slot" >> /root/.system
        fi
    done

    aktif=$(cat /root/.system | wc -l)
    echo -e "  ───────────────────────────────────────"
    echo -e "            $aktif User Online"
    echo -e "  ───────────────────────────────────────"
    sed -i "d" /root/.system
}
if [[ $# -eq 0 ]]; then
    echo "Usage: $0 {vmess|vless|trojan}"
    exit 1
fi

type=$1

if [[ ${type} == "vmess" ]]; then
    cek_vmess
elif [[ ${type} == "vless" ]]; then
    cek_vless
elif [[ ${type} == "trojan" ]]; then
    cek_trojan
elif [[ ${type} == "ssh" ]]; then
    cek_ssh    
else
    echo "Invalid type: $type"
    echo "Usage: $0 {vmess|vless|trojan}"
    exit 1
fi