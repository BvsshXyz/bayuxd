#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - CHECK LOGIN USER ALL
#   Minimalist 54-Column Modern Clean Table
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

function cek_monitor() {
    local proto_name="$1"
    local tag="$2"
    
    clear
    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    printf "${C_BORDER}│${C_HEAD}            MONITORING LOGIN USER %-15s${C_BORDER}│${NC}\n" "$proto_name"
    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME          LOGIN IP   LIMIT IP  STAT   ${C_BORDER}│${NC}"
    echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

    local count=0
    local online=0
    local proto_lower
    proto_lower=$(echo "$proto_name" | tr '[:upper:]' '[:lower:]')

    if [[ "$proto_lower" == "ssh" ]]; then
        local mulog
        mulog=$(cekssh 2>/dev/null)
        local data=( $(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null) )
        for user in "${data[@]}"; do
            if [ ! -f "/etc/kyt/limit/ssh/ip/$user" ] && ! grep -qw "$user" /etc/ssh/.ssh.db 2>/dev/null; then
                continue
            fi
            ((count++))
            local num_str=$(printf "%02d" "$count")
            local cekcek=$(echo "$mulog" | grep -w "$user" | wc -l)
            local iplimit=$(cat "/etc/kyt/limit/ssh/ip/$user" 2>/dev/null || echo "0")
            [[ "$iplimit" == "0" || -z "$iplimit" ]] && iplimit="No Limit" || iplimit="${iplimit} IP"
            local status_tag
            local login_str
            if [ "$cekcek" -gt 0 ]; then
                ((online++))
                status_tag="${C_VAL}ON    ${NC}"
                login_str="${cekcek} IP"
            else
                status_tag="${C_OFF}OFF   ${NC}"
                login_str="0 IP"
            fi
            printf "${C_BORDER}│${NC}  ${C_NUM}%-3s${NC} ${C_TEXT}%-17s${NC} ${C_VAL}%-10s${NC} ${C_CYAN}%-10s${NC}${status_tag}${C_BORDER}│${NC}\n" \
                "$num_str" "${user:0:17}" "$login_str" "$iplimit"
        done
    else
        local data=( $(grep -E "^${tag} " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2 | sort -u) )
        for akun in "${data[@]}"; do
            [[ -z "$akun" ]] && continue
            ((count++))
            local num_str=$(printf "%02d" "$count")
            local active_ips=$(grep -w "$akun" /var/log/xray/access.log 2>/dev/null | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort -u | grep -vE "^$|^127\.0\.0\.1$")
            local ip_count=$(echo "$active_ips" | grep -v "^$" | wc -l)
            local iplimit=$(cat "/etc/kyt/limit/${proto_lower}/ip/${akun}" 2>/dev/null || echo "0")
            [[ "$iplimit" == "0" || -z "$iplimit" ]] && iplimit="No Limit" || iplimit="${iplimit} IP"
            local status_tag
            local login_str
            if [ "$ip_count" -gt 0 ]; then
                ((online++))
                status_tag="${C_VAL}ON    ${NC}"
                login_str="${ip_count} IP"
            else
                status_tag="${C_OFF}OFF   ${NC}"
                login_str="0 IP"
            fi
            printf "${C_BORDER}│${NC}  ${C_NUM}%-3s${NC} ${C_TEXT}%-17s${NC} ${C_VAL}%-10s${NC} ${C_CYAN}%-10s${NC}${status_tag}${C_BORDER}│${NC}\n" \
                "$num_str" "${akun:0:17}" "$login_str" "$iplimit"
        done
    fi

    if [ "$count" -eq 0 ]; then
        printf "${C_BORDER}│${C_OFF}             TIDAK ADA AKUN TERDAFTAR               ${C_BORDER}│${NC}\n"
    fi

    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    printf "${C_BORDER}│${C_TEXT}  Total: ${C_NUM}%-2s${C_TEXT} User        Online: ${C_VAL}%-2s${C_TEXT}       Offline: ${C_OFF}%-2s${C_BORDER}│${NC}\n" \
        "$count" "$online" "$((count - online))"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
    echo ""
}

case "$1" in
    vmess) cek_monitor "VMESS" "###" ;;
    vless) cek_monitor "VLESS" "#&" ;;
    trojan) cek_monitor "TROJAN" "#!" ;;
    ssh) cek_monitor "SSH" "" ;;
    *) echo "Usage: $0 {ssh|vmess|vless|trojan}" ; exit 1 ;;
esac
