#!/bin/bash

function con() {
    local -i bytes=$1;
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( (bytes + 1023)/1024 ))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( (bytes + 1048575)/1048576 ))MB"
    else
        echo "$(( (bytes + 1073741823)/1073741824 ))GB"
    fi
}

function cek_vmess() {
    echo -n > /tmp/other.txt
    data=( $(cat /etc/xray/config.json | grep '###' | cut -d ' ' -f 2 | sort | uniq) )

    echo "--------------------------------------------"
    echo "              CEK VMESS ACCOUNT              "
    echo "--------------------------------------------"

    for akun in "${data[@]}"
    do
        if [[ -z "$akun" ]]; then
            akun="tidakada"
        fi

        echo -n > /tmp/ipvmess.txt
        data2=( $(cat /var/log/xray/access.log | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort | uniq) )

        for ip in "${data2[@]}"
        do
            jum=$(cat /var/log/xray/access.log | grep -w "$akun" | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | grep -w "$ip" | sort | uniq)
            if [[ "$jum" = "$ip" ]]; then
                echo "$jum" >> /tmp/ipvmess.txt
            else
                echo "$ip" >> /tmp/other.txt
            fi
            jum2=$(cat /tmp/ipvmess.txt)
            sed -i "/$jum2/d" /tmp/other.txt > /dev/null 2>&1
        done

        jum=$(cat /tmp/ipvmess.txt)
        if [[ -z "$jum" ]]; then
            echo > /dev/null
        else
iplimit=$(cat /etc/kyt/limit/vmess/ip/${akun})
jum2=$(cat /tmp/ipvmess.txt | wc -l)
byte=$(cat /etc/vmess/${akun})
lim=$(con ${byte})
wey=$(cat /etc/limit/vmess/${akun})
gb=$(con ${wey})
lastlogin=$(cat /var/log/xray/access.log | grep -w "$akun" | tail -n 500 | cut -d " " -f 2 | tail -1)
echo -e "┌────────────────────────────────────────────────────┐"
printf "  %-13s %-7s %-8s %2s\n" "  UserName : ${akun}"
printf "  %-13s %-7s %-8s %2s\n" "  Login    : $lastlogin"
printf "  %-13s %-7s %-8s %2s\n" "  Usage Quota : ${gb}" 
printf "  %-13s %-7s %-8s %2s\n" "  Limit Quota : ${lim}" 
printf "  %-13s %-7s %-8s %2s\n" "  Limit IP : $iplimit" 
printf "  %-13s %-7s %-8s %2s\n" "  Login IP : $jum2" 
echo -e "└────────────────────────────────────────────────────┘"
        fi 

        rm -rf /tmp/ipvmess.txt
    done

    rm -rf /tmp/other.txt
    echo ""
    echo "--------------------------------------------"
    echo ""
}

function cek_vless() {
    echo -n > /tmp/other.txt
    data=( $(cat /etc/xray/config.json | grep '#&' | cut -d ' ' -f 2 | sort | uniq) )

    echo -e "─────────────────────────────────────────────────"
    echo -e "  expired     | usage  |   quota  | limit ip | akun"
    echo -e "─────────────────────────────────────────────────"

    for akun in "${data[@]}"; do
        if [[ -z "$akun" ]]; then
            akun="tidakada"
        fi
        echo -n > /tmp/ipvless.txt
        data2=( $(cat /var/log/xray/access.log | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort | uniq) )

        for ip in "${data2[@]}"; do
            jum=$(cat /var/log/xray/access.log | grep -w "$akun" | tail -n 500 | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | grep -w "$ip" | sort | uniq)
            if [[ "$jum" = "$ip" ]]; then
                echo "$jum" >> /tmp/ipvless.txt
            else
                echo "$ip" >> /tmp/other.txt
            fi
            jum2=$(cat /tmp/ipvless.txt)
            sed -i "/$jum2/d" /tmp/other.txt > /dev/null 2>&1
        done

        jum=$(cat /tmp/ipvless.txt)
        if [[ -z "$jum" ]]; then
            echo > /dev/null
        else
            iplimit=$(cat /etc/kyt/limit/vless/ip/${akun} 2>/dev/null)
            jum2=$(cat /tmp/ipvless.txt | wc -l 2>/dev/null)
            byte=$(cat /etc/vless/${akun} 2>/dev/null)
            lim=$(con ${byte} 2>/dev/null)
            wey=$(cat /etc/limit/vless/${akun} 2>/dev.null)
            exp=$(grep -wE "^#& $akun" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
            gb=$(con ${wey} 2>/dev/null)
            lastlogin=$(cat /var/log/xray/access.log | grep -w "$akun" | tail -n 500 | cut -d " " -f 2 | tail -1 2>/dev/null)
            printf "%-10s %-10s %-10s %-20s\n" "  $exp   " "$gb" "$lim" "$iplimit IP    $akun"
            rm -rf /tmp/ipvless.txt
        fi
    done

    rm -rf /tmp/other.txt
    echo ""
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

