#!/bin/bash

function delvm() {
sed -i "/^### ${user} ${exp}/,/^},{/d" /etc/xray/config.json
rm -f /etc/kyt/limit/vmess/quota/${user}
rm -f /etc/kyt/limit/vmess/ip/${user}
rm -f /etc/vmess/${user}
rm -f /etc/limit/vmess/${user}
rm -f /var/www/html/vmess-${user}.txt
sed -i "/^### ${user} ${exp}/d" /etc/vmess/.vmess.db
systemctl restart xray
}

function delvl() {
sed -i "/^#& ${user} ${exp}/,/^},{/d" /etc/xray/config.json
rm -f /etc/kyt/limit/vless/quota/${user}
rm -f /etc/kyt/limit/vless/ip/${user}
rm -f /etc/vless/${user}
rm -f /etc/limit/vless/${user}
rm -f /var/www/html/vless-${user}.txt
sed -i "/^### ${user} ${exp}/d" /etc/vless/.vless.db
systemctl restart xray
}

function deltr() {
sed -i "/^#! ${user} ${exp}/,/^},{/d" /etc/xray/config.json
rm -f /etc/kyt/limit/trojan/quota/${user}
rm -f /etc/kyt/limit/trojan/ip/${user}
rm -f /etc/trojan/${user}
rm -f /etc/limit/trojan/${user}
rm -f /var/www/html/trojan-${user}.txt
sed -i "/^### ${user} ${exp}/d" /etc/trojan.trojan.db
systemctl restart xray
}

function delss() {
sed -i "/^#!# ${user} ${exp}/,/^},{/d" /etc/xray/config.json
rm -f /etc/xray/limit/shadowsocks/quota/${user}
rm -f /etc/xray/limit/shadowsocks/ip/${user}
rm -f /etc/shadowsocks/${user}
rm -f /etc/limit/shadowsocks/${user}
rm -f /var/www/html/ss-${user}.txt
sed -i "/^### ${user} ${exp}/d" /etc/.shadowsocks.db
systemctl restart xray
}

function delssh() {
userdel -f ${user}
rm -f /etc/xray/limit/ssh/ip/${user}
rm -f /etc/ssh/${user}
rm -f /var/www/html/ssh-${user}.txt
sed -i "/^### ${user} /d" /etc/ssh/.ssh.db
systemctl restart ws
systemctl restart dropbear
}

function delnoobz() {
noobzvpns --remove-user ${user}
sed -i "/^### $user/d" /etc/.noobz.db
rm -f /var/www/html/noobzvpns-${user}.txt
rm -f /etc/noobzvpns/${user}
systemctl restart noobzvpns
}

function kill_exp() {
##----- Auto Remove Vmess
data=($(cat /etc/xray/config.json | grep '^###' | cut -d ' ' -f 2 | sort | uniq))
now=$(date +"%Y-%m-%d")
for user in "${data[@]}"; do
    exp=$(grep -w "^### $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
    d1=$(date -d "$exp" +%s)
    d2=$(date -d "$now" +%s)
    exp2=$(((d1 - d2) / 86400))
    if [[ "$exp2" -le "0" ]]; then
        delvm
    fi
done

#----- Auto Remove Vless
data=($(cat /etc/xray/config.json | grep '^#&' | cut -d ' ' -f 2 | sort | uniq))
now=$(date +"%Y-%m-%d")
for user in "${data[@]}"; do
    exp=$(grep -w "^#& $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
    d1=$(date -d "$exp" +%s)
    d2=$(date -d "$now" +%s)
    exp2=$(((d1 - d2) / 86400))
    if [[ "$exp2" -le "0" ]]; then
        delvl
    fi
done

#----- Auto Remove Trojan
data=($(cat /etc/xray/config.json | grep '^#!' | cut -d ' ' -f 2 | sort | uniq))
now=$(date +"%Y-%m-%d")
for user in "${data[@]}"; do
    exp=$(grep -w "^#! $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
    d1=$(date -d "$exp" +%s)
    d2=$(date -d "$now" +%s)
    exp2=$(((d1 - d2) / 86400))
    if [[ "$exp2" -le "0" ]]; then
        deltr
    fi
done

#----- Auto Remove SS
data=($(cat /etc/xray/config.json | grep '^#!#' | cut -d ' ' -f 2 | sort | uniq))
now=$(date +"%Y-%m-%d")
for user in "${data[@]}"; do
    exp=$(grep -w "^#!# $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
    d1=$(date -d "$exp" +%s)
    d2=$(date -d "$now" +%s)
    exp2=$(((d1 - d2) / 86400))
    if [[ "$exp2" -le "0" ]]; then
        delss
    fi
done
systemctl restart xray

##------ Auto Remove SSH
hariini=$(date +%d-%m-%Y)
cat /etc/shadow | cut -d: -f1,8 | sed /:$/d >/tmp/expirelist.txt
totalaccounts=$(cat /tmp/expirelist.txt | wc -l)
for ((i = 1; i <= $totalaccounts; i++)); do
    tuserval=$(head -n $i /tmp/expirelist.txt | tail -n 1)
    username=$(echo $tuserval | cut -f1 -d:)
    userexp=$(echo $tuserval | cut -f2 -d:)
    userexpireinseconds=$(($userexp * 86400))
    tglexp=$(date -d @$userexpireinseconds)
    tgl=$(echo $tglexp | awk -F" " '{print $3}')
    while [ ${#tgl} -lt 2 ]; do
        tgl="0"$tgl
    done
    while [ ${#username} -lt 15 ]; do
        username=$username" "
    done
    bulantahun=$(echo $tglexp | awk -F" " '{print $2,$6}')
    todaystime=$(date +%s)
    if [ $userexpireinseconds -ge $todaystime ]; then
        :
    else
        delssh
        user=${username}
        systemctl reload ssh
    fi
done
}

if [[ "${1}" == "exp" ]]; then
kill_exp
elif [[ "${1}" == "vm" ]]; then
user=$2
exp=$(grep -w "^### $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
delvm
elif [[ "${1}" == "vl" ]]; then
user=$2
exp=$(grep -w "^#& $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
delvl
elif [[ "${1}" == "tr" ]]; then
user=$2
exp=$(grep -w "^#! $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
deltr
elif [[ "${1}" == "ss" ]]; then
user=$2
exp=$(grep -w "^#!# $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
delss
elif [[ "${1}" == "ssh" ]]; then
user=$2
delssh
elif [[ "${1}" == "nb" ]]; then
user=$2
delnoobz
else
echo >/dev/null 2>&1
fi
