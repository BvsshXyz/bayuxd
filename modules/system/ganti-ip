#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - EDIT LIMIT IP MULTI-PROTO
#   54-Column Modern Auto-Listing & Quick Number Pick
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
C_TITLE="\033[1;38;5;51m"
NC="\033[0m"

PROTO="${1:-ssh}"
PROTO_LOWER=$(echo "$PROTO" | tr '[:upper:]' '[:lower:]')
PROTO_UPPER=$(echo "$PROTO_LOWER" | tr '[:lower:]' '[:upper:]')

LIMIT_DIR="/etc/kyt/limit/${PROTO_LOWER}/ip"
mkdir -p "$LIMIT_DIR"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
printf "${C_BORDER}│${C_HEAD}              EDIT LIMIT IP USER - %-17s${C_BORDER}│${NC}\n" "$PROTO_UPPER"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME        LIMIT IP    STATUS            ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

user_list=()
limit_list=()
status_list=()

if [ "$PROTO_LOWER" = "ssh" ]; then
    mapfile -t raw_users < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null)
    for u in "${raw_users[@]}"; do
        [[ "$u" =~ ^trial ]] && continue
        cur_lim=$(cat "$LIMIT_DIR/$u" 2>/dev/null)
        if [ -z "$cur_lim" ]; then
            # fallback db
            cur_lim=$(grep -wE "^### $u" /etc/ssh/.ssh.db 2>/dev/null | awk '{print $5}')
        fi
        [[ -z "$cur_lim" || "$cur_lim" -le 0 ]] && cur_lim="0 (No Limit)" || cur_lim="${cur_lim} IP"
        
        st="ACTIVE"
        if passwd -S "$u" 2>/dev/null | grep -q " L "; then
            st="LOCKED"
        fi
        
        user_list+=("$u")
        limit_list+=("$cur_lim")
        status_list+=("$st")
    done
elif [ "$PROTO_LOWER" = "vmess" ]; then
    mapfile -t raw_users < <(grep -E "^### " "/etc/xray/config.json" 2>/dev/null | awk '{print $2}' | sort -u)
    for u in "${raw_users[@]}"; do
        cur_lim=$(cat "$LIMIT_DIR/$u" 2>/dev/null)
        [[ -z "$cur_lim" || "$cur_lim" -le 0 ]] && cur_lim="0 (No Limit)" || cur_lim="${cur_lim} IP"
        user_list+=("$u")
        limit_list+=("$cur_lim")
        status_list+=("ACTIVE")
    done
elif [ "$PROTO_LOWER" = "vless" ]; then
    mapfile -t raw_users < <(grep -E "^#& " "/etc/xray/config.json" 2>/dev/null | awk '{print $2}' | sort -u)
    for u in "${raw_users[@]}"; do
        cur_lim=$(cat "$LIMIT_DIR/$u" 2>/dev/null)
        [[ -z "$cur_lim" || "$cur_lim" -le 0 ]] && cur_lim="0 (No Limit)" || cur_lim="${cur_lim} IP"
        user_list+=("$u")
        limit_list+=("$cur_lim")
        status_list+=("ACTIVE")
    done
elif [ "$PROTO_LOWER" = "trojan" ]; then
    mapfile -t raw_users < <(grep -E "^#! " "/etc/xray/config.json" 2>/dev/null | awk '{print $2}' | sort -u)
    for u in "${raw_users[@]}"; do
        cur_lim=$(cat "$LIMIT_DIR/$u" 2>/dev/null)
        [[ -z "$cur_lim" || "$cur_lim" -le 0 ]] && cur_lim="0 (No Limit)" || cur_lim="${cur_lim} IP"
        user_list+=("$u")
        limit_list+=("$cur_lim")
        status_list+=("ACTIVE")
    done
fi

total=${#user_list[@]}
if [ "$total" -eq 0 ]; then
    echo -e "${C_BORDER}│${C_VAL}            TIDAK ADA AKUN TERDAFTAR                ${C_BORDER}│${NC}"
else
    for (( i=0; i<total; i++ )); do
        num_str=$(printf "%02d" $((i + 1)))
        u_name="${user_list[$i]}"
        u_lim="${limit_list[$i]}"
        u_st="${status_list[$i]}"
        
        c_st="${C_VAL}"
        [ "$u_st" = "LOCKED" ] && c_st="${C_OFF}"
        
        printf "${C_BORDER}│${NC}  ${C_NUM}%-4s${NC}${C_TEXT}%-16s${NC}${C_CYAN}%-12s${NC}${c_st}%-16s${NC}${C_BORDER}│${NC}\n" \
            "$num_str" "${u_name:0:16}" "${u_lim:0:12}" "$u_st"
    done
fi

echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

if [ "$total" -eq 0 ]; then
    echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu...${NC}"
    read -r
    exit 0
fi

echo -ne "${C_TITLE}» Pilih Nomor [01-${total}] atau Ketik Username [00: Batal]: ${C_VAL}"
read -r choice

if [[ "$choice" == "00" || "$choice" == "0" || -z "$choice" || "$choice" == "x" || "$choice" == "q" ]]; then
    exit 0
fi

target_user=""
current_limit="0"
if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
    idx=$(( choice - 1 ))
    target_user="${user_list[$idx]}"
    current_limit="${limit_list[$idx]}"
else
    for (( i=0; i<total; i++ )); do
        if [ "${user_list[$i]}" = "$choice" ]; then
            target_user="$choice"
            current_limit="${limit_list[$i]}"
            break
        fi
    done
fi

if [ -z "$target_user" ]; then
    echo -e "\n${C_OFF}[!] Akun '$choice' tidak ditemukan!${NC}"
    sleep 1.5
    exit 0
fi

echo ""
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}                 INPUT BATASAN IP BARU               ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT}  Username    : ${C_VAL}%-35s${C_BORDER}│${NC}\n" "$target_user"
printf "${C_BORDER}│${C_TEXT}  Limit Lama  : ${C_CYAN}%-35s${C_BORDER}│${NC}\n" "$current_limit"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

echo -ne "${C_TITLE}» Masukkan Jumlah Limit IP Baru [Contoh: 1 / 2 / 0 = Unlimited]: ${C_VAL}"
read -r new_lim

if ! [[ "$new_lim" =~ ^[0-9]+$ ]]; then
    echo -e "\n${C_OFF}[!] Input harus berupa angka valid! Batasan IP tidak berubah.${NC}"
    sleep 1.5
    exit 0
fi

# Simpan ke file limit IP
echo "$new_lim" > "$LIMIT_DIR/$target_user"

# Update ke database .db jika ada
if [ "$PROTO_LOWER" = "ssh" ]; then
    if grep -qw "$target_user" /etc/ssh/.ssh.db 2>/dev/null; then
        sed -i "/\b${target_user}\b/s/[0-9]\+$/${new_lim}/" /etc/ssh/.ssh.db 2>/dev/null || true
    fi
fi

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_VAL}            LIMIT IP BERHASIL DIPERBARUI!           ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT}  Username    : ${C_VAL}%-35s${C_BORDER}│${NC}\n" "$target_user"
printf "${C_BORDER}│${C_TEXT}  Protokol    : ${C_CYAN}%-35s${C_BORDER}│${NC}\n" "$PROTO_UPPER"
if [ "$new_lim" -eq 0 ]; then
    printf "${C_BORDER}│${C_TEXT}  Limit Baru  : ${C_VAL}%-35s${C_BORDER}│${NC}\n" "Unlimited (Bebas Device)"
else
    printf "${C_BORDER}│${C_TEXT}  Limit Baru  : ${C_VAL}%-35s${C_BORDER}│${NC}\n" "$new_lim IP Maksimal"
fi
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu...${NC}"
read -r
exit 0
