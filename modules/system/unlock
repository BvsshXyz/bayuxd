#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - UNLOCK USER SSH
#   Precise 54-Column Modern Auto-Listing & Quick Unlock
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

LOCK_DIR="/etc/kyt/limit/ssh/locked"
mkdir -p "$LOCK_DIR"
now_ts=$(date +%s)

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}                UNLOCK USER ACCOUNT                 ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME        STATUS    SISA HUKUMAN        ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

# Kumpulkan semua user yang sedang terkunci (baik di shadow maupun di lock_dir)
mapfile -t all_users < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null)
locked_users=()

count=0
for u in "${all_users[@]}"; do
    is_locked=0
    remain_str="Manual Lock"
    
    if [ -f "$LOCK_DIR/$u" ]; then
        is_locked=1
        exp_t=$(cat "$LOCK_DIR/$u" 2>/dev/null || echo "0")
        diff=$(( exp_t - now_ts ))
        if [ "$diff" -gt 0 ]; then
            m=$(( diff / 60 ))
            s=$(( diff % 60 ))
            remain_str="${m}m ${s}s"
        else
            remain_str="0m (Expired)"
        fi
    elif passwd -S "$u" 2>/dev/null | grep -q " L "; then
        is_locked=1
        remain_str="Manual Lock"
    fi
    
    if [ "$is_locked" -eq 1 ]; then
        ((count++))
        num_str=$(printf "%02d" "$count")
        locked_users+=("$u")
        printf "${C_BORDER}│${NC}  ${C_NUM}%-4s${NC}${C_TEXT}%-16s${NC}${C_OFF}%-10s${NC}${C_CYAN}%-18s${NC}  ${C_BORDER}│${NC}\n" \
            "$num_str" "${u:0:16}" "LOCKED" "$remain_str"
    fi
done

if [ "$count" -eq 0 ]; then
    printf "${C_BORDER}│${C_VAL}      TIDAK ADA AKUN SSH YANG SEDANG TERKUNCI       ${C_BORDER}│${NC}\n"
fi

echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

if [ "$count" -eq 0 ]; then
    echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu...${NC}"
    read -r
    m-sshws 2>/dev/null || exit 0
fi

echo -ne "${C_TITLE}» Pilih Nomor [01-${count}] atau Ketik Username [00: Batal]: ${C_VAL}"
read -r choice

if [[ "$choice" == "00" || "$choice" == "0" || -z "$choice" || "$choice" == "x" || "$choice" == "q" ]]; then
    m-sshws 2>/dev/null || exit 0
fi

target_user=""
if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
    idx=$(( choice - 1 ))
    target_user="${locked_users[$idx]}"
else
    # Cek apakah input berupa nama username langsung
    if grep -E -q "^$choice:" /etc/passwd; then
        target_user="$choice"
    fi
fi

if [ -n "$target_user" ]; then
    # Buka kunci di shadow
    passwd -u "$target_user" >/dev/null 2>&1
    # Hapus file penalty lock 15 menit
    rm -f "$LOCK_DIR/$target_user"
    
    clear
    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    echo -e "${C_BORDER}│${C_HEAD}               STATUS AKUN DI-BUKA                  ${C_BORDER}│${NC}"
    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    printf "${C_BORDER}│${C_TEXT} Username        : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$target_user"
    printf "${C_BORDER}│${C_TEXT} Status Akses    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "UNLOCKED (Aktif Normal)"
    printf "${C_BORDER}│${C_TEXT} Masa Hukuman    : ${C_ON}%-33s${C_BORDER}│${NC}\n" "DIRESET (Bisa Konek Lagi)"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
else
    echo -e "\n${C_OFF}[!] Akun '$choice' tidak ditemukan!${NC}"
fi

echo ""
echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu SSH...${NC}"
read -r
exit 0
