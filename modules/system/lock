#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - LOCK USER SSH
#   Precise 54-Column Modern Auto-Listing & Quick Number Pick
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
C_TITLE="\033[1;38;5;51m"
NC="\033[0m"

LOCK_DIR="/etc/kyt/limit/ssh/locked"
mkdir -p "$LOCK_DIR"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}                 LOCK USER ACCOUNT                  ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME        EXPIRED DATE      STATUS      ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

# Ambil semua akun SSH aktif (yang belum di-lock)
mapfile -t all_users < <(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null)
active_users=()

count=0
for u in "${all_users[@]}"; do
    [[ "$u" =~ ^trial ]] && continue
    # Cek apakah sudah terkunci
    if [ -f "$LOCK_DIR/$u" ] || passwd -S "$u" 2>/dev/null | grep -q " L "; then
        continue
    fi
    
    raw_exp=$(grep -wE "^### $u" /etc/ssh/.ssh.db 2>/dev/null | awk '{print $3, $4}')
    [ -z "$raw_exp" ] && raw_exp="Active"
    
    ((count++))
    num_str=$(printf "%02d" "$count")
    active_users+=("$u")
    
    printf "${C_BORDER}│${NC}  ${C_NUM}%-4s${NC}${C_TEXT}%-16s${NC}${C_CYAN}%-18s${NC}${C_VAL}%-10s${NC}  ${C_BORDER}│${NC}\n" \
        "$num_str" "${u:0:16}" "${raw_exp:0:18}" "ACTIVE"
done

if [ "$count" -eq 0 ]; then
    echo -e "${C_BORDER}│${C_VAL}       TIDAK ADA AKUN SSH AKTIF UNTUK DI-LOCK       ${C_BORDER}│${NC}"
fi

echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

if [ "$count" -eq 0 ]; then
    echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu...${NC}"
    read -r
    exit 0
fi

echo -ne "${C_TITLE}» Pilih Nomor [01-${count}] atau Ketik Username [00: Batal]: ${C_VAL}"
read -r choice

if [[ "$choice" == "00" || "$choice" == "0" || -z "$choice" || "$choice" == "x" || "$choice" == "q" ]]; then
    exit 0
fi

target_user=""
if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
    idx=$(( choice - 1 ))
    target_user="${active_users[$idx]}"
else
    if grep -E -q "^$choice:" /etc/passwd; then
        target_user="$choice"
    fi
fi

if [ -n "$target_user" ]; then
    # Lock password & putuskan koneksi aktif
    passwd -l "$target_user" >/dev/null 2>&1
    pkill -u "$target_user" 2>/dev/null || true
    
    clear
    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    echo -e "${C_BORDER}│${C_HEAD}               STATUS AKUN DI-KUNCI                 ${C_BORDER}│${NC}"
    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    printf "${C_BORDER}│${C_TEXT} Username        : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$target_user"
    printf "${C_BORDER}│${C_TEXT} Status Akses    : ${C_OFF}%-33s${C_BORDER}│${NC}\n" "LOCKED (Login Diblokir)"
    printf "${C_BORDER}│${C_TEXT} Keterangan      : ${C_TEXT}%-33s${C_BORDER}│${NC}\n" "Akses login berhasil dikunci"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
else
    echo -e "\n${C_OFF}[!] Akun '$choice' tidak ditemukan!${NC}"
fi

echo ""
echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu SSH...${NC}"
read -r
exit 0
