#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - LOCK USER SSH
#   Precise 54-Column Modern Card Layout
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}                 LOCK USER ACCOUNT                  ${C_BORDER}│${NC}"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

echo -ne "${C_NUM}» Masukkan Username yang ingin di-Lock : ${C_VAL}"
read -r username

if [ -z "$username" ]; then
    echo -e "${C_OFF}[!] Username tidak boleh kosong!${NC}"
    sleep 1.5
    exit 1
fi

if grep -E -q "^$username:" /etc/passwd; then
    passwd -l "$username" >/dev/null 2>&1
    pkill -u "$username" 2>/dev/null
    
    clear
    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    echo -e "${C_BORDER}│${C_HEAD}               STATUS AKUN DI-KUNCI                 ${C_BORDER}│${NC}"
    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    printf "${C_BORDER}│${C_TEXT} Username        : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$username"
    printf "${C_BORDER}│${C_TEXT} Status Akses    : ${C_OFF}%-33s${C_BORDER}│${NC}\n" "LOCKED (Login Diblokir)"
    printf "${C_BORDER}│${C_TEXT} Keterangan      : ${C_TEXT}%-33s${C_BORDER}│${NC}\n" "Akses login berhasil dikunci"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
else
    echo -e "\n${C_OFF}[!] Username '$username' tidak ditemukan di server!${NC}"
fi

echo ""
read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali ke menu..."
