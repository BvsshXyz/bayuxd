#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

C_BORDER="\033[38;5;39m"
C_TITLE="\033[1;38;5;51m"
C_HEAD="\033[1;38;5;220m"
C_TEXT="\033[38;5;253m"
C_VAL="\033[1;38;5;255m"
C_NUM="\033[1;38;5;51m"
C_ON="\033[1;38;5;84m"
C_OFF="\033[1;38;5;196m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_TITLE}             RENEW SSH/WS ACCOUNT                   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD} Daftar Akun SSH Aktif di Server:                   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"

users=($(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd))
total_user=${#users[@]}

if [ $total_user -eq 0 ]; then
    printf "${C_BORDER}│${C_OFF} %-51s${C_BORDER}│${NC}\n" "[!] Tidak ada akun SSH yang terdaftar."
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
    echo ""
    read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali..."
    m-sshws
    exit 0
fi

for i in "${!users[@]}"; do
    num=$((i + 1))
    u="${users[$i]}"
    exp=$(python3 /usr/local/bin/get_account_exp.py "$u" "ssh")
    printf "${C_BORDER}│${C_TEXT} [${C_NUM}%02d${C_TEXT}] ${C_VAL}%-16s ${C_TEXT}Exp: ${C_ON}%-24s${C_BORDER}│${NC}\n" "$num" "$u" "$exp"
done
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_TEXT} [${C_OFF}00${C_TEXT}] Batal dan Kembali ke Menu                     ${C_BORDER}│${NC}"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""

while true; do
    echo -ne "${C_TITLE}» Pilih Nomor Akun yang Mau Diperpanjang [1-$total_user]: ${C_VAL}"
    read -r opt
    
    if [[ "$opt" == "0" || "$opt" == "00" ]]; then
        echo -e "${C_OFF}[!] Batal memperpanjang akun.${NC}"
        sleep 1
        m-sshws
        exit 0
    fi
    
    if [[ "$opt" =~ ^[0-9]+$ ]] && [ "$opt" -ge 1 ] && [ "$opt" -le "$total_user" ]; then
        target_user="${users[$((opt - 1))]}"
        break
    else
        echo -e "${C_OFF}[!] Nomor tidak valid! Masukkan angka antara 1 sampai ${total_user}.${NC}\n"
    fi
done

if [[ "$target_user" =~ ^trial ]]; then
    while true; do
        echo -ne "${C_TITLE}» Akun TRIAL! Tambah Masa Aktif (Menit) [Default: 30]: ${C_VAL}"
        read -r Mins
        [[ -z "$Mins" ]] && Mins=30
        if [[ "$Mins" =~ ^[0-9]+$ ]] && [ "$Mins" -gt 0 ]; then
            break
        else
            echo -e "${C_OFF}[!] Masukkan angka menit yang valid!${NC}\n"
        fi
    done

    read -r new_exp_iso new_exp_show remaining_mins <<< $(python3 -c "
import datetime, re
db_line = ''
with open('/etc/ssh/.ssh.db', 'r') as f:
    for line in f:
        parts = line.split()
        if len(parts) >= 2 and parts[1] == '$target_user':
            db_line = line.strip()
            break
base = datetime.datetime.now()
m = re.search(r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})', db_line)
if m:
    try:
        t = datetime.datetime.strptime(m.group(1), '%Y-%m-%d %H:%M')
        if t > base:
            base = t
    except Exception:
        pass
new_t = base + datetime.timedelta(minutes=$Mins)
rem = int((new_t - datetime.datetime.now()).total_seconds() / 60)
if rem < 1: rem = 1
print(new_t.strftime('%Y-%m-%d %H:%M'), new_t.strftime('%H:%M'), rem)
")
sed -i "/\\b${target_user}\\b/d" /etc/ssh/.ssh.db 2>/dev/null || true
echo "### $target_user $new_exp_iso 0 1" >> /etc/ssh/.ssh.db
echo "userdel -f $target_user 2>/dev/null; rm -f /etc/kyt/limit/ssh/ip/$target_user; sed -i '/\\b${target_user}\\b/d' /etc/ssh/.ssh.db" | at now + ${remaining_mins} minutes &>/dev/null

    echo -e "\n${C_ON}[✓] Akun TRIAL SSH Nomor [$opt] ($target_user) berhasil diperpanjang +${Mins} Menit! (Expired: $new_exp_show)${NC}"
else
    while true; do
        echo -ne "${C_TITLE}» Tambah Masa Aktif (Hari) [Default: 30]: ${C_VAL}"
        read -r Days
        [[ -z "$Days" ]] && Days=30
        if [[ "$Days" =~ ^[0-9]+$ ]] && [ "$Days" -gt 0 ]; then
            break
        else
            echo -e "${C_OFF}[!] Masukkan angka hari yang valid!${NC}\n"
        fi
    done

    read -r new_date_iso new_date_fmt <<< $(python3 -c "
import datetime, re
db_line = ''
with open('/etc/ssh/.ssh.db', 'r') as f:
    for line in f:
        parts = line.split()
        if len(parts) >= 2 and parts[1] == '$target_user':
            db_line = line.strip()
            break
base = datetime.datetime.now()
m = re.search(r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})', db_line)
if m:
    try:
        t = datetime.datetime.strptime(m.group(1), '%Y-%m-%d %H:%M')
        if t > base: base = t
    except Exception: pass
else:
    m2 = re.search(r'(\d{4}-\d{2}-\d{2})', db_line)
    if m2:
        try:
            t = datetime.datetime.strptime(m2.group(1), '%Y-%m-%d')
            if t > base: base = t
        except Exception: pass
new = base + datetime.timedelta(days=$Days)
print(new.strftime('%Y-%m-%d %H:%M'), new.strftime('%d %b, %Y [%H:%M]'))
")
chage -E "$(date -d "$new_date_iso + 1 day" +%Y-%m-%d)" "$target_user" 2>/dev/null
sed -i "/\\b${target_user}\\b/d" /etc/ssh/.ssh.db 2>/dev/null || true
echo "### $target_user $new_date_iso 0 1" >> /etc/ssh/.ssh.db

    echo -e "\n${C_ON}[✓] Akun SSH Nomor [$opt] ($target_user) berhasil diperpanjang +${Days} Hari! (Expired: $new_date_iso)${NC}"
fi

sleep 1.5
renewssh
