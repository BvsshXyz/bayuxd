#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - USER DETAIL SSH/OVPN
#   Precise 54-Column Modern Card Layout
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}              DETAIL USER ACCOUNT SSH               ${C_BORDER}│${NC}"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"

count=0

while read -r line; do
    [[ -z "$line" ]] && continue
    # Format line: ### user exp pass limit
    user=$(echo "$line" | awk '{print $2}')
    exp=$(echo "$line" | awk '{print $3}')
    pass=$(echo "$line" | awk '{print $4}')
    limit=$(echo "$line" | awk '{print $5}')
    
    [[ -z "$user" ]] && continue
    ((count++))
    num_str=$(printf "%02d" "$count")
    
    # Cek status lock / aktif
    if passwd -S "$user" 2>/dev/null | grep -q "L"; then
        status_tag="${C_OFF}LOCKED${NC}"
    else
        status_tag="${C_VAL}ACTIVE${NC}"
    fi
    
    # Cek live online
    active_login=$(pgrep -u "$user" 2>/dev/null | wc -l)
    if [ "$active_login" -gt 0 ]; then
        online_str="${C_VAL}Online ($active_login Proc)${NC}"
    else
        online_str="${C_OFF}Offline${NC}"
    fi
    
    [[ -z "$limit" || "$limit" == "0" ]] && limit_str="No Limit" || limit_str="${limit} IP"

    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    printf "${C_BORDER}│${C_NUM} [%s]${C_TEXT} Username : ${C_VAL}%-18s${C_TEXT} Status: %-14b${C_BORDER}│${NC}\n" \
        "$num_str" "${user:0:18}" "$status_tag"
    echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
    printf "${C_BORDER}│${C_TEXT} Password       : ${C_CYAN}%-33s${C_BORDER}│${NC}\n" "${pass:0:33}"
    printf "${C_BORDER}│${C_TEXT} Max Limit IP   : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$limit_str"
    printf "${C_BORDER}│${C_TEXT} Status Login   : %-42b${C_BORDER}│${NC}\n" "$online_str"
    printf "${C_BORDER}│${C_TEXT} Expired Date   : ${C_NUM}%-33s${C_BORDER}│${NC}\n" "$exp"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
done < <(grep -E "^### " /etc/ssh/.ssh.db 2>/dev/null)

if [ "$count" -eq 0 ]; then
    echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
    echo -e "${C_BORDER}│${C_OFF}             TIDAK ADA DATA USER SSH                ${C_BORDER}│${NC}"
    echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
fi

echo ""
read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali ke menu..."
