#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - CHECK LIVE SSH SESSIONS
#   Outputs raw "PID - USER - IP" for Limit / Monitor
# ====================================================

LOG="/var/log/auth.log"
[ ! -f "$LOG" ] && [ -f "/var/log/secure" ] && LOG="/var/log/secure"

# 1. Dropbear Active Sessions
data=( $(ps aux | grep -i dropbear | grep -v grep | awk '{print $2}') )
if [ -f "$LOG" ]; then
    grep -i dropbear "$LOG" 2>/dev/null | grep -i "Password auth succeeded" > /tmp/login-db.txt
    for PID in "${data[@]}"; do
        grep "dropbear\[$PID\]" /tmp/login-db.txt 2>/dev/null > /tmp/login-db-pid.txt
        NUM=$(wc -l < /tmp/login-db-pid.txt 2>/dev/null)
        USER=$(awk '{print $10}' /tmp/login-db-pid.txt 2>/dev/null | tr -d "'")
        IP=$(awk '{print $12}' /tmp/login-db-pid.txt 2>/dev/null | cut -d: -f1)
        if [ "$NUM" -ge 1 ] && [ -n "$USER" ]; then
            echo "$PID - $USER - $IP"
        fi
    done
fi

# 2. OpenSSH Active Sessions
data_ssh=( $(ps aux | grep "sshd: " | grep "\[priv\]" | grep -v grep | awk '{print $2}') )
if [ -f "$LOG" ]; then
    grep -i sshd "$LOG" 2>/dev/null | grep -i "Accepted password for" > /tmp/login-sshd.txt
    for PID in "${data_ssh[@]}"; do
        grep "sshd\[$PID\]" /tmp/login-sshd.txt 2>/dev/null > /tmp/login-sshd-pid.txt
        NUM=$(wc -l < /tmp/login-sshd-pid.txt 2>/dev/null)
        USER=$(awk '{print $9}' /tmp/login-sshd-pid.txt 2>/dev/null | tr -d "'")
        IP=$(awk '{print $11}' /tmp/login-sshd-pid.txt 2>/dev/null)
        if [ "$NUM" -ge 1 ] && [ -n "$USER" ]; then
            echo "$PID - $USER - $IP"
        fi
    done
fi

# 3. OpenVPN Active Sessions
if [ -f "/etc/openvpn/server/openvpn-tcp.log" ]; then
    grep -w "^CLIENT_LIST" /etc/openvpn/server/openvpn-tcp.log 2>/dev/null | while IFS=',' read -r _ vuser vip _; do
        [ -n "$vuser" ] && [ "$vuser" != "UNDEF" ] && echo "0 - $vuser - $vip"
    done
fi
if [ -f "/etc/openvpn/server/openvpn-udp.log" ]; then
    grep -w "^CLIENT_LIST" /etc/openvpn/server/openvpn-udp.log 2>/dev/null | while IFS=',' read -r _ vuser vip _; do
        [ -n "$vuser" ] && [ "$vuser" != "UNDEF" ] && echo "0 - $vuser - $vip"
    done
fi

rm -f /tmp/login-db*.txt /tmp/login-sshd*.txt 2>/dev/null
