#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - CHECK LOGIN USER UDP
#   Precise 54-Column Modern Border & Live IP Audit
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}              MONITORING LOGIN USER UDP             ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────┬──────────────────┬──────────┬──────────┬──────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD} NO ${C_BORDER}│${C_HEAD} USERNAME         ${C_BORDER}│${C_HEAD} LOGIN IP ${C_BORDER}│${C_HEAD} LIMIT IP ${C_BORDER}│${C_HEAD} STAT ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────┼──────────────────┼──────────┼──────────┼──────┤${NC}"

udp_status=$(systemctl status udp-custom 2>/dev/null)
data=( $(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null) )

count=0
online=0

for user in "${data[@]}"; do
    if [ ! -f "/etc/kyt/limit/ssh/ip/$user" ] && ! grep -qw "$user" /etc/ssh/.ssh.db 2>/dev/null; then
        continue
    fi
    
    ((count++))
    num_str=$(printf "%02d" "$count")
    
    cekcek=$(echo "$udp_status" | grep -w "$user" | wc -l)
    iplimit=$(cat "/etc/kyt/limit/ssh/ip/$user" 2>/dev/null || echo "0")
    if [[ "$iplimit" == "0" || -z "$iplimit" ]]; then
        iplimit="No Limit"
    else
        iplimit="${iplimit} IP"
    fi
    
    if [ "$cekcek" -gt 0 ]; then
        ((online++))
        status_tag="${C_VAL} ON ${NC}"
        login_str="${cekcek} IP"
    else
        status_tag="${C_OFF}OFF ${NC}"
        login_str="0 IP"
    fi
    
    printf "${C_BORDER}│${C_NUM} %-2s ${C_BORDER}│${C_TEXT} %-16s ${C_BORDER}│${C_VAL} %-8s ${C_BORDER}│${C_CYAN} %-8s ${C_BORDER}│${status_tag}${C_BORDER}│${NC}\n" \
        "$num_str" "${user:0:16}" "$login_str" "$iplimit"
done

if [ "$count" -eq 0 ]; then
    printf "${C_BORDER}│${C_OFF}             TIDAK ADA AKUN UDP TERDAFTAR           ${C_BORDER}│${NC}\n"
fi

echo -e "${C_BORDER}├────┴──────────────────┴──────────┴──────────┴──────┤${NC}"
printf "${C_BORDER}│${C_TEXT} Total: ${C_NUM}%-3s${C_TEXT} User   │ Online: ${C_VAL}%-2s${C_TEXT} User  │ Offline: ${C_OFF}%-3s${C_BORDER}│${NC}\n" \
    "$count" "$online" "$((count - online))"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""
read -n 1 -s -r -p "Tekan [ Enter ] untuk kembali ke menu..."
