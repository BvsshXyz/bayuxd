#!/bin/bash
# ====================================================
#   BAYU XD TUNNELING SYSTEM - CHECK LOGIN USER SSH
#   Minimalist 54-Column Modern Clean Table
# ====================================================

C_BORDER="\033[1;36m"
C_HEAD="\033[1;37m"
C_TEXT="\033[0;37m"
C_VAL="\033[1;32m"
C_OFF="\033[1;31m"
C_NUM="\033[1;33m"
C_CYAN="\033[0;36m"
NC="\033[0m"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_HEAD}              MONITORING LOGIN USER SSH             ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}  NO  USERNAME          LOGIN IP   LIMIT IP  STAT   ${C_BORDER}│${NC}"
echo -e "${C_BORDER}│ ────────────────────────────────────────────────── │${NC}"

# Ambil data login live dari dropbear dan sshd
mulog=$(cekssh 2>/dev/null)
data=( $(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd 2>/dev/null) )

count=0
online=0

for user in "${data[@]}"; do
    # Filter hanya akun yang terdaftar di database SSH autoscript
    if [ ! -f "/etc/kyt/limit/ssh/ip/$user" ] && ! grep -qw "$user" /etc/ssh/.ssh.db 2>/dev/null; then
        continue
    fi
    
    ((count++))
    num_str=$(printf "%02d" "$count")
    
    cekcek=$(echo "$mulog" | grep -w "$user" | wc -l)
    iplimit=$(cat "/etc/kyt/limit/ssh/ip/$user" 2>/dev/null || echo "0")
    if [[ "$iplimit" == "0" || -z "$iplimit" ]]; then
        iplimit="No Limit"
    else
        iplimit="${iplimit} IP"
    fi
    
    if [ "$cekcek" -gt 0 ]; then
        ((online++))
        status_tag="${C_VAL}ON    ${NC}"
        login_str="${cekcek} IP"
    else
        status_tag="${C_OFF}OFF   ${NC}"
        login_str="0 IP"
    fi
    
    printf "${C_BORDER}│${NC}  ${C_NUM}%-3s${NC} ${C_TEXT}%-17s${NC} ${C_VAL}%-10s${NC} ${C_CYAN}%-10s${NC}${status_tag}${C_BORDER}│${NC}\n" \
        "$num_str" "${user:0:17}" "$login_str" "$iplimit"
done

if [ "$count" -eq 0 ]; then
    printf "${C_BORDER}│${C_OFF}            TIDAK ADA AKUN SSH TERDAFTAR            ${C_BORDER}│${NC}\n"
fi

echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT}  Total: ${C_NUM}%-2s${C_TEXT} User        Online: ${C_VAL}%-2s${C_TEXT}       Offline: ${C_OFF}%-2s${C_BORDER}│${NC}\n" \
    "$count" "$online" "$((count - online))"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""
echo -ne "${C_CYAN}Tekan [ Enter ] untuk kembali ke menu SSH...${NC}"
read -r
m-sshws
