#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

C_BORDER="\033[38;5;39m"
C_TITLE="\033[1;38;5;51m"
C_HEAD="\033[1;38;5;220m"
C_TEXT="\033[38;5;253m"
C_VAL="\033[1;38;5;255m"
C_ON="\033[1;38;5;84m"
C_GOLD="\033[1;38;5;214m"
C_SUB="\033[38;5;246m"
NC="\033[0m"

print_boxed_content() {
    local text="$1"
    local chunk=""
    while [ -n "$text" ]; do
        chunk="${text:0:50}"
        text="${text:50}"
        printf "${C_BORDER}│${NC} ${C_SUB}%-50s${NC} ${C_BORDER}│${NC}\n" "$chunk"
    done
}

clear
Login="trial`cat /dev/urandom | tr -dc '0-9' | fold -w 4 | head -n 1`"
Pass="1"
iplimit=1
domain=$(cat /etc/xray/domain 2>/dev/null || echo "vpn.bayuuvx.com")
ns_domain=$(cat /etc/xray/dns 2>/dev/null || echo "ns.${domain}")
ip=$(cat /etc/xray/ipvps 2>/dev/null || curl -sS ipv4.icanhazip.com || echo "201.79.110.81")
city=$(cat /etc/xray/city 2>/dev/null || echo "Singapore")
isp=$(cat /etc/xray/isp 2>/dev/null || echo "DigitalOcean, LLC")

tgl_create=$(date +"%d %b, %Y [%H:%M]")
exp_time=$(date -d "+30 minutes" +"%H:%M")
exp_date=$(date -d "+30 minutes" +"%Y-%m-%d %H:%M")
exp_show=$(date -d "+30 minutes" +"%d %b, %Y [%H:%M]")

# Create user without fixed expiry date (managed by at daemon in 30 mins)
useradd -s /bin/false -M "$Login" 2>/dev/null
echo -e "$Pass\n$Pass" | passwd "$Login" &>/dev/null

mkdir -p /etc/kyt/limit/ssh/ip /etc/ssh /var/www/html
echo "1" > "/etc/kyt/limit/ssh/ip/$Login"

sed -i "/\\b${Login}\\b/d" /etc/ssh/.ssh.db 2>/dev/null || true
echo "### ${Login} ${exp_date} 0 1" >> /etc/ssh/.ssh.db

echo "userdel -f $Login 2>/dev/null; rm -f /etc/kyt/limit/ssh/ip/$Login /var/www/html/ssh-$Login.txt; sed -i '/\\b${Login}\\b/d' /etc/ssh/.ssh.db" | at now + 30 minutes &>/dev/null

payload="GET / HTTP/1.1[crlf]Host: ${domain}[crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf]Upgrade: websocket[crlf][crlf]"
link_ovpn="https://${domain}:81/"
link_save="https://${domain}:81/ssh-${Login}.txt"
txt_iplimit="1 Device (Trial)"

# Simpan file web config trial
cat > "/var/www/html/ssh-${Login}.txt" << 'EOF'
=================================================
          TRIAL SSH & OVPN ACCOUNT DETAILS
=================================================
Username         : LOGIN_NAME
Password         : PASS_VAL
Limit IP         : LIMIT_VAL
Masa Aktif       : 30 Menit (EXP_TIME)
Dibuat Pada      : CREATE_DATE
Berakhir Pada    : EXP_DATE
=================================================
               SERVER & PORT INFO
=================================================
Host / Domain    : DOMAIN_NAME
Host SlowDNS     : NS_DOMAIN_NAME
Location         : CITY_NAME
ISP Provider     : ISP_NAME
Port OpenSSH     : 22, 22022
Port SSH UDP     : 1-65535
Port Dropbear    : 443, 109, 143
Port SSH WS      : 80, 8080
Port SSH SSL WS  : 443
Port SSL/TLS     : 443
Port OVPN WS SSL : 443
Port OVPN SSL    : 443
Port OVPN TCP    : 443, 1194
Port OVPN UDP    : 2200
BadVPN UDPGW     : 7100, 7200, 7300
=================================================
Payload WS       : GET / HTTP/1.1[crlf]Host: DOMAIN_NAME[crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf]Upgrade: websocket[crlf][crlf]
OVPN Download    : https://DOMAIN_NAME:81/
Save Link Account: https://DOMAIN_NAME:81/ssh-LOGIN_NAME.txt
=================================================
EOF

sed -i "s/LOGIN_NAME/$Login/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/PASS_VAL/$Pass/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/LIMIT_VAL/$txt_iplimit/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/EXP_TIME/$exp_time/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/CREATE_DATE/$tgl_create/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/EXP_DATE/$exp_show/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/DOMAIN_NAME/$domain/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/NS_DOMAIN_NAME/$ns_domain/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/CITY_NAME/$city/g" "/var/www/html/ssh-${Login}.txt"
sed -i "s/ISP_NAME/$isp/g" "/var/www/html/ssh-${Login}.txt"
chmod 644 "/var/www/html/ssh-${Login}.txt"

clear
echo -e "${C_BORDER}┌────────────────────────────────────────────────────┐${NC}"
echo -e "${C_BORDER}│${C_TITLE}             TRIAL SSH & OVPN CREATED               ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT} Username        : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$Login"
printf "${C_BORDER}│${C_TEXT} Password        : ${C_GOLD}%-33s${C_BORDER}│${NC}\n" "$Pass"
printf "${C_BORDER}│${C_TEXT} Limit IP        : ${C_ON}%-33s${C_BORDER}│${NC}\n" "$txt_iplimit"
printf "${C_BORDER}│${C_TEXT} Masa Aktif      : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "30 Menit [$exp_time]"
printf "${C_BORDER}│${C_TEXT} Dibuat Pada     : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$tgl_create"
printf "${C_BORDER}│${C_TEXT} Berakhir Pada   : ${C_ON}%-33s${C_BORDER}│${NC}\n" "$exp_show"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD}                SERVER & PORT INFO                  ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
printf "${C_BORDER}│${C_TEXT} Host / Domain   : ${C_TITLE}%-33s${C_BORDER}│${NC}\n" "$domain"
printf "${C_BORDER}│${C_TEXT} Host SlowDNS    : ${C_TITLE}%-33s${C_BORDER}│${NC}\n" "$ns_domain"
printf "${C_BORDER}│${C_TEXT} Location        : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$city"
printf "${C_BORDER}│${C_TEXT} ISP Provider    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "$isp"
printf "${C_BORDER}│${C_TEXT} Port OpenSSH    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "22, 22022"
printf "${C_BORDER}│${C_TEXT} Port SSH UDP    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "1-65535"
printf "${C_BORDER}│${C_TEXT} Port Dropbear   : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443, 109, 143"
printf "${C_BORDER}│${C_TEXT} Port SSH WS     : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "80, 8080"
printf "${C_BORDER}│${C_TEXT} Port SSH SSL WS : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443"
printf "${C_BORDER}│${C_TEXT} Port SSL/TLS    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443"
printf "${C_BORDER}│${C_TEXT} Port OVPN WS SSL: ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443"
printf "${C_BORDER}│${C_TEXT} Port OVPN SSL   : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443"
printf "${C_BORDER}│${C_TEXT} Port OVPN TCP   : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "443, 1194"
printf "${C_BORDER}│${C_TEXT} Port OVPN UDP   : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "2200"
printf "${C_BORDER}│${C_TEXT} BadVPN UDPGW    : ${C_VAL}%-33s${C_BORDER}│${NC}\n" "7100, 7200, 7300"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD} PAYLOAD WEBSOCKET:                                 ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
print_boxed_content "$payload"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD} OVPN DOWNLOAD (CONFIG CLIENT):                     ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
print_boxed_content "$link_ovpn"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
echo -e "${C_BORDER}│${C_HEAD} SAVE LINK ACCOUNT (WEB CHECK):                     ${C_BORDER}│${NC}"
echo -e "${C_BORDER}├────────────────────────────────────────────────────┤${NC}"
print_boxed_content "$link_save"
echo -e "${C_BORDER}└────────────────────────────────────────────────────┘${NC}"
echo ""
echo -ne "${C_TITLE}Tekan [ Enter ] untuk kembali ke menu...${NC}"
read -r
m-sshws
